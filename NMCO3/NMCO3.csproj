<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>nmco3</AssemblyName>
    <StripSymbols>true</StripSymbols>
    <!-- The launcher tells this dll from Nexon's original by the version resource: do not change Product. -->
    <Product>OpenCrazyArcade NMCO3</Product>
    <Company>OpenCrazyArcade</Company>
    <Description>OpenCrazyArcade replacement for Nexon nmco3.dll</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- the pipe contract shared with the launcher -->
    <ProjectReference Include="..\Ipc\Ipc.csproj" />
  </ItemGroup>

</Project>
