<Window x:Class="OpenCrazyArcade.AutoUpdate.UI.Windows.LauncherWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OpenCrazyArcade Launcher"
        Width="837" Height="667"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Icon="/Assets/app.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom Button Template for Nostalgic Close Button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image x:Name="ImgNormal" Source="/Assets/btn_close_normal.png" Visibility="Visible"/>
                            <Image x:Name="ImgHover" Source="/Assets/btn_close_hover.png" Visibility="Collapsed"/>
                            <Image x:Name="ImgPressed" Source="/Assets/btn_close_pressed.png" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ImgNormal" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ImgHover" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ImgNormal" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ImgHover" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ImgPressed" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nostalgic Orange Pill Button -->
        <Style x:Key="NostalgicOrangeButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="16" BorderThickness="1.5" BorderBrush="#9A3816" Padding="16,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFA74F" Offset="0"/>
                                    <GradientStop Color="#F3631A" Offset="0.5"/>
                                    <GradientStop Color="#DF4A0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Color="#5A1A05"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFBF73" Offset="0"/>
                                            <GradientStop Color="#FF7A2F" Offset="0.5"/>
                                            <GradientStop Color="#F05B16" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#CF410B" Offset="0"/>
                                            <GradientStop Color="#E35515" Offset="0.5"/>
                                            <GradientStop Color="#FF903C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nostalgic Blue Pill Button -->
        <Style x:Key="NostalgicBlueButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="16" BorderThickness="1.5" BorderBrush="#1C5B8A" Padding="14,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5FB6F3" Offset="0"/>
                                    <GradientStop Color="#1E82D2" Offset="0.5"/>
                                    <GradientStop Color="#1061A6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Color="#0B3960"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#80CAFF" Offset="0"/>
                                            <GradientStop Color="#369DF0" Offset="0.5"/>
                                            <GradientStop Color="#1A77C5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0B4B85" Offset="0"/>
                                            <GradientStop Color="#146DB8" Offset="0.5"/>
                                            <GradientStop Color="#3E9EE8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nostalgic Red Kill Game Pill Button -->
        <Style x:Key="NostalgicRedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="16" BorderThickness="1.5" BorderBrush="#8A1C1C" Padding="14,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F35F5F" Offset="0"/>
                                    <GradientStop Color="#D21E1E" Offset="0.5"/>
                                    <GradientStop Color="#A61010" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nostalgic Header Nav Hyperlink (No underline normally, underline on hover) -->
        <Style x:Key="NostalgicHyperlinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Foreground" Value="#FFF2A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Width="837" Height="667">
        <!-- 1. VNG Nostalgic Background Frame -->
        <Image Source="/Assets/launcher_bg_oca.png" Width="837" Height="667" Stretch="Uniform" IsHitTestVisible="True"/>

        <!-- 2. Close Button [X] at Top-Right -->
        <Button Style="{StaticResource CloseButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="794,27,0,0"
                Click="BtnClose_Click"/>

        <TextBlock
            Margin="280,170,10,10"
            VerticalAlignment="Top"
            Foreground="#FFFFFF"
            FontSize="13"
            FontWeight="SemiBold">
            <Hyperlink
                Style="{StaticResource NostalgicHyperlinkStyle}"
                Click="Hyperlink_GotoProjectHome_Click">Trang Dự Án</Hyperlink>
            <Run Text=" | " FontSize="22" Foreground="#D0E8FF"/>
            <Hyperlink
                Style="{StaticResource NostalgicHyperlinkStyle}"
                Click="Hyperlink_GotoServerHome_Click">Trang Máy Chủ</Hyperlink>
        </TextBlock>

        <!-- 3. WebView2 Browser in the Nostalgic Content Box -->
        <Border Margin="30,205,37,114" Background="White" CornerRadius="2" ClipToBounds="True">
            <wv2:WebView2 x:Name="NewsWebView"/>
        </Border>

        <!-- 4. Bottom Controls -->
        <Grid Height="80" VerticalAlignment="Bottom" Margin="42,0,42,16">
            <!-- Status text -->
            <TextBlock x:Name="TxtStatus" Text="Sẵn sàng tham gia OpenCrazyArcade!"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="10,-10,0,0"
                       FontSize="13" FontWeight="SemiBold" Foreground="#104A7D"/>
            <!-- Shown only after an update actually changed files; see CheckUpdatesAsync. -->
            <TextBlock x:Name="TxtUpdateTime" Visibility="Collapsed"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="10,30,0,0"
                       FontSize="10" Foreground="#104A7D"/>

            <!-- Right Buttons: [Chế độ cửa sổ] [Cấu hình] and [Bắt đầu] -->
            <StackPanel
                Margin="415, -25, 0, 0"
                Orientation="Vertical"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">


                <CheckBox x:Name="ChkWindowedMode" Content="Chế độ cửa sổ"
                          FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                          VerticalAlignment="Center" Margin="0,0,12,10" IsChecked="True"
                          Click="ChkWindowedMode_Click"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnStart" Content="▶ Bắt Đầu"
                            Width="190"
                            Style="{StaticResource NostalgicOrangeButton}"
                            Click="BtnStart_Click"/>
                    <Button x:Name="BtnConfig" Content="⚙"
                            Width="50"
                            Margin="-50,-69,0,0"
                            Padding="0,0,0,0"
                            BorderThickness="0"
                            FontSize="15"
                        Style="{StaticResource NostalgicBlueButton}"
                        Click="BtnConfig_Click"
                        PreviewMouseRightButtonUp="BtnConfig_RightClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 5. Config Dialog Overlay (Modal popup) -->
        <Grid x:Name="ConfigOverlay" Background="#99000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Width="420" Background="#F8FAFC" CornerRadius="12" BorderThickness="2" BorderBrush="#0080FF"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Cấu Hình Kết Nối OpenCrazyArcade" FontSize="16" FontWeight="Bold" Foreground="#104A7D" Margin="0,0,0,14"/>

                    <!-- Server URL -->
                    <TextBlock Text="Địa chỉ Máy Chủ:" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtServerUrl" Height="30" FontSize="13" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,4"/>
                    <TextBlock Text="Địa chỉ do chủ máy chủ cung cấp, ví dụ: https://server-address.example" FontSize="11" Foreground="#666" Margin="0,0,0,14"/>

                    <!-- Checkboxes -->
                    <CheckBox x:Name="ChkConfigWindowedMode" Content="Khởi động game ở chế độ cửa sổ (Windowed Mode)"
                              FontSize="12" Margin="0,0,0,8" IsChecked="True"/>
                    <CheckBox x:Name="ChkAutoUpdateStartup" Content="Tự động kiểm tra bản cập nhật khi khởi động"
                              FontSize="12" Margin="0,0,0,8" IsChecked="True"/>
                    <CheckBox x:Name="ChkConfigClientLog" Content="Ghi nhật ký game (để gửi lại khi gặp lỗi)"
                              FontSize="12" Margin="0,0,0,4" IsChecked="True"/>
                    <TextBlock x:Name="TxtLogDir" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="20,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,16">
                        <Button Content="Nhật ký game" Width="110" Height="24" Margin="0,0,8,0"
                                Style="{StaticResource NostalgicBlueButton}" Click="BtnOpenLogs_Click"/>
                        <Button Content="Nhật ký launcher" Width="120" Height="24" Margin="0,0,8,0"
                                Style="{StaticResource NostalgicBlueButton}" Click="BtnOpenLauncherLogs_Click"/>
                        <Button Content="Nhật ký nmco3" Width="110" Height="24"
                                Style="{StaticResource NostalgicBlueButton}" Click="BtnOpenNmco3Logs_Click"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Lưu Cấu Hình" Width="130" Height="30" Margin="0,0,8,0"
                                Style="{StaticResource NostalgicOrangeButton}" Click="BtnSaveConfig_Click"/>
                        <Button Content="Đóng" Width="75" Height="30"
                                Style="{StaticResource NostalgicBlueButton}" Click="BtnCloseConfig_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
